        <entry>
          <string>Testdata</string>
          <testData>
            <dataString>           RST_ CLK IR_eff
init TEST_=0;
	   0    0   0x7F
loop(n,15)
           1    C   0x7F
end loop
loop(n,16)
           1    C   0x60
end loop
loop(n,16)
           1    C   0x10
end loop
loop(n,16)
           1    C   0x20
end loop
loop(n,16)
           1    C   0x30
end loop
loop(n,16)
           1    C   0x06
end loop
           1    0   0xAB
loop(n,16)
           1    C   0xAB
end loop
           1    0   0xAB
           1    1   0xAB
           1    0   0xCD
memory TESTPROG(0x0)=0xAB;
memory TESTPROG(0x1)=0xCD;</dataString>
          </testData>
        </entry>
      </elementAttributes>
