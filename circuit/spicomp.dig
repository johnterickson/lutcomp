          <testData>
            <dataString>           RST_ CLK IR
	   0    0   0
loop(n,32)
           1    0   X
           1    1   X
end loop
loop(n,8)
           1    0   X
           1    1   X
end loop
           1    0   0xAB
loop(n,7)
           1    C   0xAB
end loop
           1    0   0xAB
           1    1   0xAB
           1    0   0xCD
memory PROG(0x0)=0xAB;
memory PROG(0x1)=0xCD;</dataString>
          </testData>
